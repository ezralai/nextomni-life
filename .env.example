# NextOmni Life Unified Configuration
# The Intelligent Operating System for Human Flourishing

# ==========================================
# 1. Next.js Web App (apps/web)
# ==========================================
NEXT_PUBLIC_APP_NAME="NextOmni Life"
NEXT_PUBLIC_APP_TAGLINE="The Intelligent Operating System for Human Flourishing"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AI_ENGINE_URL="http://localhost:8000"
PORT=3000

# Auth Secrets
NEXTAUTH_SECRET="super-secret-nextomni-jwt-key-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==========================================
# 2. Database & Cache
# ==========================================
# Serverless PostgreSQL (Supabase / Neon connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/nextomni?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/nextomni?schema=public"

# Redis Cache (Upstash Serverless)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==========================================
# 3. FastAPI AI Engine (apps/ai-engine)
# ==========================================
AI_ENGINE_PORT=8000
AI_ENGINE_HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI Provider Keys (BYOK or Master Server Key)
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
AI_ENCRYPTION_KEY="nextomni-secret-fernet-key-32bytes-base64="
